# Quran Story Universe — Supabase STAGING template (example only)
# Copy to .env.staging and fill values. NEVER commit .env.staging with real keys.

# Required for staging smoke + reviewer sign-in
VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: distinguish staging vs production in UI badge
# Values: staging | production
VITE_SUPABASE_ENV=staging

# SECURITY NOTES
# - Never commit real keys to git
# - Anon key is allowed in frontend (RLS protects data)
# - NEVER put service_role key in frontend or .env committed files
# - Local mode (VITE_DATA_MODE=local) remains the default for npm run qa

# Staging setup: see docs/staging_supabase_setup.md
