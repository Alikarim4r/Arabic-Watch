# Quran Story Universe — environment template
# Copy to .env for Vite-based builds, or inject via window.__QSU_ENV__ for static serve.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DATA_MODE=local

# VITE_DATA_MODE options:
#   local    — load src/data/*.json (default, no credentials required)
#   supabase — use Supabase repository (falls back to local if URL/key missing)
