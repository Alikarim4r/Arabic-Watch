# Quran Story Universe — environment template
# Copy to .env for local dev with Vite, or inject via window.__QSU_ENV__ for static serve.

# Default: local JSON mode — no Supabase credentials required (npm run qa)
VITE_DATA_MODE=local

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional when using Supabase: staging | production (UI badge only)
VITE_SUPABASE_ENV=staging

# VITE_DATA_MODE options:
#   local    — load src/data/*.json (default, no credentials required)
#   supabase — use Supabase auth + review persistence (falls back to local if URL/key missing)

# SECURITY
# - NEVER commit real Supabase keys
# - Anon key is allowed in frontend; service_role key is NEVER allowed in client code
# - For staging, copy .env.staging.example → .env.staging (gitignored)

# Supabase setup:
# 1. Run supabase/migrations/001, 002, 003
# 2. Load seed: node scripts/export_seed_to_supabase_sql.mjs → run SQL in Supabase
# 3. Create auth users + reviewer_profiles (see docs/staging_supabase_setup.md)
# 4. Set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
# 5. Optional live checks: npm run qa:staging

# Review actions in Supabase mode are audit-only — they do NOT auto-approve public content.
